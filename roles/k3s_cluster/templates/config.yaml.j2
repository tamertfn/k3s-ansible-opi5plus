# K3s Server Configuration
# Generated by Ansible for HA embedded etcd cluster (Cilium CNI ready)

{% if inventory_hostname == k3s_server_init_node %}
cluster-init: true
{% else %}
server: "https://{{ kube_vip_address }}:6443"
{% endif %}

token: "{{ k3s_token }}"
node-ip: "{{ ansible_host }}"

# CNI & Network Configuration (Prepared for Cilium via Helm)
flannel-backend: "none"
disable-network-policy: true
disable-kube-proxy: true

# Disabled built-in components to avoid conflicts with Kube-VIP / Cilium
disable:
  - servicelb
{% if k3s_disable_traefik | default(false) %}
  - traefik
{% endif %}

# TLS Subject Alternative Names
tls-san:
{% for san in k3s_tls_san %}
  - "{{ san }}"
{% endfor %}
{% for host in groups['opi_nodes'] %}
  - "{{ hostvars[host]['ansible_host'] }}"
  - "{{ host }}"
  - "{{ host }}.{{ base_domain }}"
{% endfor %}

write-kubeconfig-mode: "0644"
