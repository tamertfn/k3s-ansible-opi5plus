# Traefik Helm Values generated by Ansible for K3s HA Cluster
deployment:
  enabled: true
  kind: Deployment
  replicas: {{ traefik_replicas }}

providers:
  kubernetesGateway:
    enabled: true
  kubernetesIngress:
    enabled: true
  kubernetesCRD:
    enabled: true

gateway:
  enabled: true
  name: traefik-gateway
  namespace: {{ traefik_namespace }}
  listeners:
    web:
      port: 8000
      protocol: HTTP
      namespacePolicy:
        from: All
    websecure:
      port: 8443
      protocol: HTTPS
      namespacePolicy:
        from: All
      certificateRefs:
        - name: {{ traefik_tls_secret_name }}

service:
  enabled: true
  type: LoadBalancer
  annotations:
    io.cilium/lb-ipam-ips: "{{ traefik_lb_ip }}"
  spec:
    externalTrafficPolicy: Local

ports:
  web:
    exposedPort: 80
  websecure:
    exposedPort: 443

ingressRoute:
  dashboard:
    enabled: true
    matchRule: Host(`{{ traefik_dashboard_domain }}`)
    entryPoints:
      - web
      - websecure
    tls:
      secretName: {{ traefik_tls_secret_name }}
    middlewares:
      - name: dashboard-redirect

extraObjects:
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: dashboard-redirect
      namespace: {{ traefik_namespace }}
    spec:
      redirectRegex:
        regex: ^(https?://[^/]+)/?$
        replacement: ${1}/dashboard/
        permanent: true
  - apiVersion: traefik.io/v1alpha1
    kind: TLSStore
    metadata:
      name: default
      namespace: {{ traefik_namespace }}
    spec:
      defaultCertificate:
        secretName: {{ traefik_tls_secret_name }}
