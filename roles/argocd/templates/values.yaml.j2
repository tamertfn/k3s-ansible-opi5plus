# ArgoCD Helm Values generated by Ansible for K3s HA Cluster
global:
  domain: "{{ argocd_domain }}"
  networkPolicy:
    create: false

configs:
  params:
    # Disable TLS on the ArgoCD server pod since Traefik terminates TLS at Ingress/Gateway
    server.insecure: true
  cm:
    url: "https://{{ argocd_domain }}"
    admin.enabled: true
    statusbadge.enabled: true

server:
  replicas: {{ argocd_server_replicas | default(2) }}
  ingress:
    enabled: false

repoServer:
  replicas: {{ argocd_repo_server_replicas | default(2) }}

controller:
  replicas: {{ argocd_controller_replicas | default(1) }}

redis:
  enabled: {{ not (argocd_redis_ha_enabled | default(true)) }}

redis-ha:
  enabled: {{ argocd_redis_ha_enabled | default(true) }}

applicationSet:
  replicas: {{ argocd_applicationset_replicas | default(2) }}
  enabled: true

dex:
  enabled: true

notifications:
  enabled: true

extraObjects:
  - apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      name: argocd-server
      namespace: {{ argocd_namespace }}
    spec:
      entryPoints:
        - websecure
      routes:
        - kind: Rule
          match: Host(`{{ argocd_domain }}`) && Headers(`Content-Type`, `application/grpc`)
          priority: 11
          services:
            - name: argocd-server
              port: 80
              scheme: h2c
        - kind: Rule
          match: Host(`{{ argocd_domain }}`)
          priority: 10
          services:
            - name: argocd-server
              port: 80
      tls:
        secretName: {{ argocd_tls_secret_name }}
  - apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      name: argocd-server-http
      namespace: {{ argocd_namespace }}
    spec:
      entryPoints:
        - web
      routes:
        - kind: Rule
          match: Host(`{{ argocd_domain }}`)
          middlewares:
            - name: argocd-redirect-https
          services:
            - name: argocd-server
              port: 80
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: argocd-redirect-https
      namespace: {{ argocd_namespace }}
    spec:
      redirectScheme:
        scheme: https
        permanent: true
